# Default AI: Qwen through local Ollama (run: ollama pull qwen2.5:7b)
PORT=3001
DEFAULT_PROVIDER=qwen-local

# Optional cloud providers (leave blank to hide them in the app)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=

# Optional: forward SOS alerts to a webhook (Slack, LINE bridge, etc.)
SOS_WEBHOOK_URL=

# Robot bridge: mock | websocket
ROBOT_MODE=mock
ROBOT_WS_URL=ws://192.168.1.50:81
