# Port the app listens on (open http://<this-computer>:3001 from other devices)
PORT=3001

# Default AI: Qwen through local Ollama.
# QWEN_MODEL must be a model you pulled with `ollama pull`. Smaller = faster:
#   qwen2.5:7b (best answers, needs a fast computer), qwen2.5:3b (good for Raspberry Pi 5 8GB), qwen2.5:1.5b (fastest)
DEFAULT_PROVIDER=qwen-local
QWEN_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434/v1

# Administrator account (username: admin). Created on first start if it does not exist yet.
# Use a strong password (8+ characters) and change it after the first sign-in.
ADMIN_PASSWORD=

# Optional cloud providers (leave blank to hide them in the app)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=

# Optional: forward SOS alerts to a webhook (Slack, LINE bridge, etc.)
SOS_WEBHOOK_URL=

# Robot bridge: mock | websocket
ROBOT_MODE=mock
ROBOT_WS_URL=ws://192.168.1.50:81
